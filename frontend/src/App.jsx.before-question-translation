  function speechCode() {
    const codes = {
      English: "en-IN",
      Hindi: "hi-IN",
      Marathi: "mr-IN",
      Tamil: "ta-IN",
      Telugu: "te-IN",
      Bengali: "bn-IN",
    };

    return codes[language] || "en-IN";
  }

  function speak(text) {
    if (!text || !window.speechSynthesis) {
      return;
    }

    window.speechSynthesis.cancel();

    const message = new SpeechSynthesisUtterance(text);

    message.lang = speechCode();
    message.rate = 0.85;
    message.pitch = 1;
    message.volume = 1;

    message.onstart = () => {
      setSpeaking(true);
    };

    message.onend = () => {
      setSpeaking(false);
    };

    message.onerror = () => {
      setSpeaking(false);
    };

    window.speechSynthesis.speak(message);
  }

  useEffect(() => {
    if (screen !== "interview" || completed) {
